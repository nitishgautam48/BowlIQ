# Copy to .env and edit. Never commit .env.

# ── Sign-in ─────────────────────────────────────────────────────────────
# Leave empty for single-user mode: a random access token is created on first start, printed in the console
# and saved in storage/.api_token. For several people use owner:token pairs (tokens ≥ 16 characters), e.g.
#   BOWLIQ_API_TOKENS=me:Kq3...long-random...,coach:Zp9...long-random...
BOWLIQ_API_TOKENS=

# ── Report writer (optional) ────────────────────────────────────────────
# Free key from https://aistudio.google.com/apikey. Empty = deterministic template report.
GEMINI_API_KEY=
# Pin a dated Gemini Flash model id that is available on the free tier.
GEMINI_MODEL=gemini-2.5-flash

# ── Gemini video check (optional, off by default) ───────────────────────
# 1 = Gemini watches each clip once first (which person bowls, camera view, bowling arm, slow motion, roughly when
# the release happens) and the local pipeline uses that as hints, checking each against its own measurements.
# The processed clip (trimmed, small, no sound) is SENT TO GOOGLE. Needs GEMINI_API_KEY and internet; any failure
# just skips the check. Measurements (key moments, angles, speeds) are always made locally.
BOWLIQ_GEMINI_VIDEO=0
# Empty = use GEMINI_MODEL. A model that accepts video input.
GEMINI_VIDEO_MODEL=

# ── Network ─────────────────────────────────────────────────────────────
BOWLIQ_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Host names the API answers to (protects against DNS rebinding). Add your domain if you deploy.
BOWLIQ_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Limits & housekeeping ───────────────────────────────────────────────
BOWLIQ_MAX_QUEUED_JOBS=5
BOWLIQ_RATE_ANALYZE_PER_MIN=6
BOWLIQ_RATE_READ_PER_MIN=600
# Delete analyses older than N days (0 = keep forever)
BOWLIQ_RETENTION_DAYS=0

# ── Processing ──────────────────────────────────────────────────────────
# Pose engine: auto | mediapipe | yolo
#   auto = YOLO26x-pose on your NVIDIA GPU when PyTorch-CUDA + requirements-gpu.txt are installed, else MediaPipe (CPU).
#   If the GPU engine can't find the bowler in a clip, MediaPipe is used automatically for that clip.
BOWLIQ_POSE_BACKEND=auto
# GPU engine input size (multiple of 32). 1280 = tested default; 960 is ~2x faster with slightly less detail.
BOWLIQ_YOLO_IMGSZ=1280
BOWLIQ_YOLO_BATCH=8
# Video encoding: auto (NVIDIA NVENC if it works, else libx264) | nvenc | x264
BOWLIQ_VIDEO_ENCODER=auto
# Phase 1c: correct camera movement and zoom in on small bowlers (false = analyse the video exactly as filmed)
BOWLIQ_ADAPT_VIDEO=true
# MediaPipe delegate: auto | gpu | cpu   (MediaPipe's GPU delegate is not available on Windows)
BOWLIQ_POSE_DELEGATE=auto
# true = the API process also runs the job worker. false = run `python -m app.worker` separately.
BOWLIQ_EMBEDDED_WORKER=true
# Optional: where the database and analysis files live (default: backend/storage)
# BOWLIQ_STORAGE_DIR=E:\BowlIQData
BOWLIQ_LOG_LEVEL=INFO
